generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}
enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
enum CampaignType {
  REMINDER
  NOTICE
  INFORMATIONAL
  PROMOTION
  URGENT
}
enum CampaignChannel {
  WHATSAPP
  SMS
  BOTH
}
enum ExecutionMode {
  DEMO
  TWILIO_TEST
  META_TEST
  ULTRAMSG
  LIVE
}
enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}
enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  SIMULATED
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(VIEWER)
  isActive Boolean @default(true)
  mfaEnabled Boolean @default(false)
  mfaSecret String?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  segments Segment[]
  campaigns Campaign[]
  auditLogs AuditLog[]
}
model Contact {
  id String @id @default(uuid())
  firstName String
  lastName String
  documentId String?
  phone String @unique
  email String?
  department String?
  zone String?
  groupName String?
  status ContactStatus @default(ACTIVE)
  whatsappOptIn Boolean @default(false)
  smsOptIn Boolean @default(false)
  consentSource String?
  consentAt DateTime?
  optOutAt DateTime?
  isTwilioTestNumber Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients CampaignRecipient[]
}
model Segment {
  id String @id @default(uuid())
  name String
  description String?
  filters Json
  isDynamic Boolean @default(true)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaigns Campaign[]
}
model Campaign {
  id String @id @default(uuid())
  name String
  type CampaignType
  channel CampaignChannel
  executionMode ExecutionMode @default(DEMO)
  status CampaignStatus @default(DRAFT)
  message String
  whatsappTemplate String?
  variables Json?
  contactIds Json?
  scheduledAt DateTime?
  sentAt DateTime?
  segmentId String?
  segment Segment? @relation(fields: [segmentId], references: [id])
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  estimatedRecipients Int @default(0)
  estimatedCost Decimal @db.Decimal(12, 4) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients CampaignRecipient[]
}
model CampaignRecipient {
  id String @id @default(uuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId String
  contact Contact @relation(fields: [contactId], references: [id])
  channel CampaignChannel
  status RecipientStatus @default(PENDING)
  providerMessageId String?
  errorMessage String?
  renderedMessage String
  estimatedCost Decimal @db.Decimal(12, 4) @default(0)
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([campaignId, contactId, channel])
}
model AuditLog {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
}
model AppSetting {
  id String @id @default(uuid())
  organizationName String
  logoDataUrl String? @db.Text
  supportEmail String?
  supportPhone String?
  allowedStartHour Int @default(8)
  allowedEndHour Int @default(20)
  whatsappUtilityRatePerThousand Decimal @db.Decimal(12,4) @default(0)
  whatsappMarketingRatePerThousand Decimal @db.Decimal(12,4) @default(0)
  smsRatePerThousand Decimal @db.Decimal(12,4) @default(0)
  mfaEnforced Boolean @default(false)
  updatedAt DateTime @updatedAt
}
